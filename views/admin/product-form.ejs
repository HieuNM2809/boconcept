<%- include('../partials/head') %>
<body class="admin">
<%- include('_nav', {section: 'products'}) %>
<%# Form sản phẩm KHÔNG dùng admin-narrow (720px) như các form khác: nó có tới
    ~20 trường + 4 ô soạn thảo, nhồi vào một cột hẹp thì phải cuộn rất dài.
    Bố cục 2 cột — nội dung bên trái, thiết lập xuất bản bên phải — thay vì kéo
    dãn một cột cho hết màn hình: một ô "Slug" rộng 1900px còn khó dùng hơn. %>
<main class="admin-wrap">
    <div class="admin-head">
        <h1><%= item ? ('SỬA SẢN PHẨM ' + item.id) : 'THÊM SẢN PHẨM' %></h1>
        <a class="btn-sm" href="/admin/products">← Quay lại</a>
    </div>
    <form class="admin-form admin-form-wide" method="post" action="<%= action %>">
        <div class="form-main">
            <section class="form-card">
                <h2 class="admin-subhead">THÔNG TIN SẢN PHẨM</h2>
                <%# form-grid-auto: số cột tự co theo bề ngang (mỗi ô tối thiểu 240px).
                    Màn rộng xếp 3 ô một hàng, laptop 13" xuống 2, điện thoại còn 1 —
                    không phải viết media query cho từng mức. %>
                <div class="form-grid-auto">
                    <div><label for="name_vi">Tên sản phẩm *</label><input id="name_vi" name="name_vi" required value="<%= item ? item.name_vi : '' %>"></div>
                    <div><label for="name_en">Tên tiếng anh</label><input id="name_en" name="name_en" value="<%= item ? (item.name_en || '') : '' %>"></div>
                    <div><label for="slug">Slug</label><input id="slug" name="slug" value="<%= item ? (item.slug || '') : '' %>" placeholder="tu-dong-sinh-neu-de-trong"></div>
                </div>
                <%# VI và EN đặt CẠNH nhau chứ không trên–dưới: dịch nội dung là việc
                    đối chiếu hai bản, xếp dọc thì phải cuộn qua lại mới so được. %>
                <div class="form-pair">
                    <div><label for="description_vi">Mô tả sản phẩm</label><textarea id="description_vi" name="description_vi" rows="10"><%= item ? (item.description_vi || '') : '' %></textarea></div>
                    <div><label for="description_en">Mô tả tiếng anh</label><textarea id="description_en" name="description_en" rows="10"><%= item ? (item.description_en || '') : '' %></textarea></div>
                </div>
            </section>

            <section class="form-card">
                <h2 class="admin-subhead">THUỘC TÍNH SẢN PHẨM</h2>
                <div class="form-grid-auto">
                    <div><label for="material_vi">Chất liệu sản phẩm</label><input id="material_vi" name="material_vi" value="<%= item ? (item.material_vi || '') : '' %>" placeholder="Gỗ sồi · Vải"></div>
                    <div><label for="material_en">Chất liệu tiếng anh</label><input id="material_en" name="material_en" value="<%= item ? (item.material_en || '') : '' %>" placeholder="Oak · Fabric"></div>
<%# Hai ô "Màu sản phẩm"/"Màu tiếng anh" đã chuyển thành mục "Màu sắc" bên dưới
    (ô chọn màu thật, khách bấm được). Bỏ ở đây để admin không phải nhập màu ở
    hai chỗ rồi lệch nhau. Cột color_vi/color_en trong DB GIỮ NGUYÊN — normalize()
    cũng đã thôi đọc chúng, nên lưu sản phẩm không ghi đè dữ liệu cũ. %>
                    <div><label for="dimensions_vi">Kích thước sản phẩm</label><textarea id="dimensions_vi" name="dimensions_vi" rows="3" placeholder="Ghế: 10x30x60"><%= item ? (item.dimensions_vi || '') : '' %></textarea></div>
                    <div><label for="dimensions_en">Kích thước tiếng anh</label><textarea id="dimensions_en" name="dimensions_en" rows="3" placeholder="Chair: 10x30x60"><%= item ? (item.dimensions_en || '') : '' %></textarea></div>
                    <div><label for="weight">Khối lượng (kg)</label><input type="number" step="0.01" min="0" id="weight" name="weight" value="<%= item && item.weight != null ? Number(item.weight) : '' %>" placeholder="Để trống nếu không có"></div>
                </div>
            </section>

            <section class="form-card">
                <h2 class="admin-subhead">Bộ sưu tập hình ảnh</h2>
                <p class="admin-hint">
                    Ảnh phụ hiện ở trang chi tiết cùng “Ảnh chính”. Bấm “+ Thêm ảnh” để thêm dòng,
                    mỗi dòng chọn được ảnh từ máy hoặc dán đường dẫn. Xoá hết chữ trong ô là ảnh đó bị bỏ khi lưu.
                </p>
                <%# Tên trường dạng mảng gallery[] — controller lọc bỏ ô rỗng rồi ghi lại
                    toàn bộ danh sách, nên thêm/xoá/đổi thứ tự đều xử lý được trong một lần lưu. %>
                <div id="galleryRows" class="gallery-rows">
                    <% (item && item.images ? item.images : []).forEach(function (img, i) { %>
                        <div class="gallery-row">
                            <img class="gallery-row-thumb" src="<%= img.url %>" alt="" data-preview-for="gal<%= i %>">
                            <input type="file" accept="image/*" data-encode-to="gal<%= i %>">
                            <input type="text" id="gal<%= i %>" name="gallery[]" value="<%= img.url %>" placeholder="https://...">
                            <button type="button" class="btn-sm danger" data-remove-row>Xóa</button>
                        </div>
                    <% }) %>
                </div>
                <button type="button" class="btn-sm" id="addGalleryRow">+ Thêm ảnh</button>
            </section>

            <section class="form-card">
                <h2 class="admin-subhead">Màu sắc</h2>
                <p class="admin-hint">
                    Hiện ở trang chi tiết thành các ô vuông màu cho khách bấm chọn — <strong>không hiện chữ</strong>.
                    Tên màu chỉ dùng làm chú thích khi rê chuột và cho trình đọc màn hình của người khiếm thị.
                    Cột “Ảnh” chọn một ảnh trong Bộ sưu tập ở trên: bấm màu nào thì ảnh chính đổi sang ảnh đó.
                    Ảnh vừa thêm phải bấm Lưu một lần rồi mới chọn được ở đây.
                </p>
                <%# Ô ẩn này LUÔN được gửi kèm form. Nó là thứ phân biệt "admin đã xoá
                    hết màu" với "payload API không đụng tới màu": thiếu nó thì xoá dòng
                    màu CUỐI CÙNG sẽ không có tác dụng, vì controller không thấy field
                    nào tên color_hex và hiểu nhầm là giữ nguyên. %>
                <input type="hidden" name="has_colors" value="1">
                <%# data-image-options: sẵn danh sách <option> để JS dựng dòng mới không
                    phải dò lại DOM của dòng cũ (sản phẩm chưa có màu nào thì không có
                    dòng nào để dò). %>
                <div id="colorRows" class="gallery-rows"
                     data-image-options="<%= (item && item.images ? item.images : []).map(function (img, gi) { return '<option value="' + gi + '">Ảnh ' + (gi + 1) + '</option>'; }).join('') %>">
                    <% (item && item.colors ? item.colors : []).forEach(function (c) { %>
                        <div class="gallery-row color-row">
                            <input type="color" name="color_hex[]" value="<%= c.hex %>" title="Chọn màu">
                            <input type="text" name="color_name_vi[]" value="<%= c.name_vi || '' %>" placeholder="Tên màu (VD: Nâu óc chó)">
                            <input type="text" name="color_name_en[]" value="<%= c.name_en || '' %>" placeholder="Tên tiếng anh">
                            <select name="color_image[]">
                                <option value="">— không đổi ảnh —</option>
                                <% (item && item.images ? item.images : []).forEach(function (img, gi) { %>
                                    <option value="<%= gi %>" <%= String(c.image_index) === String(gi) ? 'selected' : '' %>>Ảnh <%= gi + 1 %></option>
                                <% }) %>
                            </select>
                            <button type="button" class="btn-sm danger" data-remove-row>Xóa</button>
                        </div>
                    <% }) %>
                </div>
                <button type="button" class="btn-sm" id="addColorRow">+ Thêm màu</button>
            </section>

            <section class="form-card">
                <h2 class="admin-subhead">THÔNG TIN THÊM</h2>
          
                <div class="form-pair">
                    <div>
                        <label for="extra_vi">Tiếng Việt</label>
                        <%- include('_editor', {name: 'extra_vi', rows: 12, value: item ? (item.extra_vi || '') : '', tools: 'full'}) %>
                    </div>
                    <div>
                        <label for="extra_en">English</label>
                        <%- include('_editor', {name: 'extra_en', rows: 12, value: item ? (item.extra_en || '') : '', tools: 'full'}) %>
                    </div>
                </div>
            </section>

            <section class="form-card">
                <h2 class="admin-subhead">Thông tin vận chuyển</h2>
                <div class="form-pair">
                    <div>
                        <label for="shipping_vi">Tiếng Việt</label>
                        <%- include('_editor', {name: 'shipping_vi', rows: 8, value: item ? (item.shipping_vi || '') : '', tools: 'full'}) %>
                    </div>
                    <div>
                        <label for="shipping_en">English</label>
                        <%- include('_editor', {name: 'shipping_en', rows: 8, value: item ? (item.shipping_en || '') : '', tools: 'full'}) %>
                    </div>
                </div>
            </section>
        </div>

        <%# Cột phải dính theo màn hình (sticky): nút Lưu luôn trong tầm mắt, không
            phải cuộn xuống đáy trang dài sau mỗi lần sửa một ô. %>
        <aside class="form-side">
            <section class="form-card">
                <%# hideUrl: bỏ ô dán URL bên dưới khung upload theo yêu cầu — chỉ
                    upload ảnh từ máy. Ảnh vẫn lưu bình thường (input thành hidden). %>
                <%- include('_image-field', {name: 'thumbnail', label: 'Ảnh chính', value: item ? (item.thumbnail || '') : '', hideUrl: true}) %>
            </section>

            <section class="form-card">
                <h2 class="admin-subhead">Xuất bản</h2>
                <label for="category_id">Danh mục</label>
                <select id="category_id" name="category_id">
                    <option value="">— Không —</option>
                    <% categories.forEach(function (c) { %>
                        <option value="<%= c.id %>" <%= (item && item.category_id === c.id) ? 'selected' : '' %>><%= c.name_vi %></option>
                    <% }) %>
                </select>
                <label for="price">Giá (VNĐ)</label>
                <%# `max` để trình duyệt chặn ngay tại chỗ; server vẫn kiểm lại
                    bằng price.helper vì thuộc tính này sửa được qua devtools. %>
                <input type="number" step="1000" min="0" max="<%= maxPrice %>"
                       id="price" name="price" value="<%= item ? Number(item.price || 0) : 0 %>">
                <span class="admin-hint">Tối đa <%= maxPrice.toLocaleString('vi-VN') %> ₫</span>
                <label for="status">Trạng thái</label>
                <select id="status" name="status">
                    <option value="1" <%= (!item || item.status) ? 'selected' : '' %>>Hiện</option>
                    <option value="0" <%= (item && !item.status) ? 'selected' : '' %>>Ẩn</option>
                </select>
                <label for="is_featured">Nổi bật (hero/trang chủ)</label>
                <select id="is_featured" name="is_featured">
                    <option value="0" <%= (!item || !item.is_featured) ? 'selected' : '' %>>Không</option>
                    <option value="1" <%= (item && item.is_featured) ? 'selected' : '' %>>Có</option>
                </select>
                <label for="priority">Ưu tiên (thứ tự)</label>
                <input type="number" id="priority" name="priority" value="<%= item ? item.priority : 0 %>">

                <% if (item && item.variants && item.variants.length) { %>
                    <p class="admin-note">Biến thể hiện có: <%= item.variants.map(function (v) { return v.name; }).join(', ') %> (quản lý biến thể sẽ bổ sung sau).</p>
                <% } %>

                <div class="form-actions">
                    <button class="btn btn-primary" type="submit"><%= item ? 'Lưu thay đổi' : 'Thêm' %></button>
                    <a class="btn btn-outline" href="/admin/products">Hủy</a>
                </div>
            </section>
        </aside>
    </form>
</main>
<script src="/static/js/admin.js"></script>
</body>
</html>
