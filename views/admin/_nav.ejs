<%
/* Menu dọc bên trái. Khai báo một mảng thay vì lặp <a> bằng tay: thêm mục mới
   chỉ sửa một dòng, và không còn nguy cơ quên `class="active"` ở mục nào đó. */
/* Mục "Nhân viên" (quản lý tài khoản) CHỈ hiện với admin — staff không có quyền
   vào (route cũng chặn bằng requireRole). adminUser do adminAuth.middleware gắn. */
const isAdmin = typeof adminUser !== 'undefined' && adminUser && adminUser.role === 'admin';
const otherItems = [
    {key: 'partners',     href: '/admin/partners',     label: 'Đối tác',    icon: '🤝'},
    {key: 'certificates', href: '/admin/certificates', label: 'Chứng nhận', icon: '🏅'},
];
if (isAdmin) otherItems.push({key: 'staff', href: '/admin/staff', label: 'Nhân viên', icon: '👥'});

const adminMenu = [
    {group: 'Trang chủ', items: [
        {key: 'slides',       href: '/admin/slides',       label: 'Slideshow',         icon: '🖼️'},
        {key: 'slogan',       href: '/admin/slogan',       label: 'Heading',           icon: '🏷️'},
        {key: 'features',     href: '/admin/features',     label: 'Công năng',         icon: '⭐'},
    ]},
    {group: 'Sản phẩm', items: [
        {key: 'products',     href: '/admin/products',     label: 'Sản phẩm',          icon: '🛋️'},
        {key: 'categories',   href: '/admin/categories',   label: 'Loại sản phẩm',     icon: '🗂️'},
    ]},
    {group: 'Nội dung', items: [
        {key: 'gallery',      href: '/admin/gallery',      label: 'Lưới ảnh',          icon: '🧩'},
        {key: 'news',         href: '/admin/news',         label: 'Tin tức',           icon: '📰'},
        {key: 'pages',        href: '/admin/pages',        label: 'Trang giới thiệu',  icon: '📄'},
    ]},
    {group: 'Khác', items: otherItems},
];
%>
<a class="admin-skip" href="#adminMain">Bỏ qua menu</a>

<%# Ngăn xếp toast: admin.js đọc ?msg / ?err trên URL (do controller chuyển hướng
    kèm) rồi chèn popup vào đây. aria-live=polite để trình đọc màn hình đọc lên
    mà không cướp tiêu điểm. Có mặt trên MỌI trang admin vì _nav được include khắp nơi. %>
<div class="toast-stack" id="toastStack" aria-live="polite" aria-atomic="false"></div>

<aside class="admin-side">
    <div class="admin-top">
        <%# Nút hamburger: chỉ hiện ≤1280px (CSS), bấm để xổ menu dọc bên dưới. %>
        <button type="button" class="admin-nav-toggle" id="adminNavToggle"
                aria-label="Mở menu" aria-controls="adminSideNav" aria-expanded="false">☰</button>
        <a class="admin-brand" href="/admin">⚙️ Quản trị</a>
        <% if (typeof adminUser !== 'undefined' && adminUser) { %>
            <div class="admin-user">
                <button type="button" class="admin-avatar" id="avatarBtn" aria-haspopup="true" aria-expanded="false"
                        title="<%= adminUser.full_name || adminUser.username %>">
                    <%= ((adminUser.full_name || adminUser.username || '?').trim().charAt(0) || '?').toUpperCase() %>
                </button>
                <div class="admin-usermenu" id="userMenu" hidden>
                    <div class="admin-usermenu-head">
                        <span class="admin-usermenu-name"><%= adminUser.full_name || adminUser.username %></span>
                        <span class="badge-role <%= adminUser.role %>"><%= adminUser.role === 'admin' ? 'Admin' : 'Staff' %></span>
                    </div>
                    <a href="/admin/account"><span aria-hidden="true">👤</span> Tài khoản</a>
                    <a href="/admin/logout"><span aria-hidden="true">🚪</span> Đăng xuất</a>
                </div>
            </div>
        <% } %>
    </div>

    <nav class="admin-nav" id="adminSideNav" aria-label="Menu quản trị">
        <% adminMenu.forEach(function (g) { %>
            <p class="admin-nav-group"><%= g.group %></p>
            <% g.items.forEach(function (it) { %>
                <a href="<%= it.href %>" class="<%= section === it.key ? 'active' : '' %>"
                   <%= section === it.key ? 'aria-current="page"' : '' %>>
                    <span class="admin-nav-icon" aria-hidden="true"><%= it.icon %></span>
                    <span><%= it.label %></span>
                </a>
            <% }) %>
        <% }) %>
    </nav>

    <a class="admin-bar-link" href="/" target="_blank" rel="noopener">Xem site ↗</a>
</aside>

<style>
    .badge-role{display:inline-block;padding:1px 8px;border-radius:999px;font-size:12px;font-weight:600;line-height:1.7;vertical-align:middle}
    .badge-role.admin{background:#e7f0ff;color:#1b4fbf}
    .badge-role.staff{background:#eef1f4;color:#556}
    .admin-hint{font-weight:400;color:#888;font-size:12px}
    /* Avatar + menu người dùng ở ĐẦU sidebar (bấm avatar để mở menu) */
    .admin-top{display:flex;align-items:center;gap:10px}
    .admin-user{position:relative;margin-left:auto}
    .admin-avatar{width:38px;height:38px;border-radius:50%;border:0;cursor:pointer;
        background:var(--accent,#c39a5e);color:#fff;font-weight:700;font-size:16px;
        display:flex;align-items:center;justify-content:center}
    .admin-avatar:hover{filter:brightness(.95)}
    .admin-usermenu{position:absolute;top:46px;right:0;min-width:210px;background:#fff;
        border:1px solid var(--line,#e5e8eb);border-radius:10px;box-shadow:0 10px 30px rgba(0,0,0,.14);
        padding:8px;z-index:60;display:flex;flex-direction:column;gap:2px}
    .admin-usermenu[hidden]{display:none}
    .admin-usermenu-head{display:flex;align-items:center;gap:8px;justify-content:space-between;
        padding:8px 10px;border-bottom:1px solid var(--line,#eee);margin-bottom:4px}
    .admin-usermenu-name{font-weight:600;font-size:14px}
    .admin-usermenu a{display:flex;align-items:center;gap:8px;padding:9px 10px;border-radius:8px;
        color:#414a53;font-size:14px}
    .admin-usermenu a:hover{background:var(--soft,#f7f8fa)}
</style>
<script>
    (function () {
        // Hamburger (mobile/tablet ≤1280px): bật/tắt menu dọc.
        var navToggle = document.getElementById('adminNavToggle');
        var side = document.querySelector('.admin-side');
        if (navToggle && side) {
            navToggle.addEventListener('click', function () {
                var open = side.classList.toggle('nav-open');
                navToggle.setAttribute('aria-expanded', String(open));
            });
        }
        // Menu avatar
        var btn = document.getElementById('avatarBtn'), menu = document.getElementById('userMenu');
        if (!btn || !menu) return;
        function close() { menu.hidden = true; btn.setAttribute('aria-expanded', 'false'); }
        btn.addEventListener('click', function (e) {
            e.stopPropagation();
            var willOpen = menu.hidden;
            menu.hidden = !willOpen;
            btn.setAttribute('aria-expanded', String(willOpen));
        });
        // Bấm ra ngoài / nhấn Esc thì đóng menu.
        document.addEventListener('click', function (e) {
            if (!menu.hidden && !menu.contains(e.target) && e.target !== btn) close();
        });
        document.addEventListener('keydown', function (e) { if (e.key === 'Escape') close(); });
    })();
</script>
