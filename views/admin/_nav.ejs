<%
/* Menu dọc bên trái. Khai báo một mảng thay vì lặp <a> bằng tay: thêm mục mới
   chỉ sửa một dòng, và không còn nguy cơ quên `class="active"` ở mục nào đó. */
/* Mục "Nhân viên" (quản lý tài khoản) CHỈ hiện với admin — staff không có quyền
   vào (route cũng chặn bằng requireRole). adminUser do adminAuth.middleware gắn. */
const isAdmin = typeof adminUser !== 'undefined' && adminUser && adminUser.role === 'admin';
const otherItems = [
    {key: 'partners',     href: '/admin/partners',     label: 'Đối tác',    icon: '🤝'},
    {key: 'certificates', href: '/admin/certificates', label: 'Chứng nhận', icon: '🏅'},
];
if (isAdmin) otherItems.push({key: 'staff', href: '/admin/staff', label: 'Nhân viên', icon: '👥'});

const adminMenu = [
    {group: 'Trang chủ', items: [
        {key: 'slides',       href: '/admin/slides',       label: 'Slideshow',         icon: '🖼️'},
        {key: 'slogan',       href: '/admin/slogan',       label: 'Heading',           icon: '🏷️'},
        {key: 'features',     href: '/admin/features',     label: 'Công năng',         icon: '⭐'},
    ]},
    {group: 'Sản phẩm', items: [
        {key: 'products',     href: '/admin/products',     label: 'Sản phẩm',          icon: '🛋️'},
        {key: 'categories',   href: '/admin/categories',   label: 'Loại sản phẩm',     icon: '🗂️'},
    ]},
    {group: 'Nội dung', items: [
        {key: 'gallery',      href: '/admin/gallery',      label: 'Lưới ảnh',          icon: '🧩'},
        {key: 'news',         href: '/admin/news',         label: 'Tin tức',           icon: '📰'},
        {key: 'pages',        href: '/admin/pages',        label: 'Trang giới thiệu',  icon: '📄'},
    ]},
    {group: 'Khác', items: otherItems},
];
%>
<a class="admin-skip" href="#adminMain">Bỏ qua menu</a>

<%# Ngăn xếp toast: admin.js đọc ?msg / ?err trên URL (do controller chuyển hướng
    kèm) rồi chèn popup vào đây. aria-live=polite để trình đọc màn hình đọc lên
    mà không cướp tiêu điểm. Có mặt trên MỌI trang admin vì _nav được include khắp nơi. %>
<div class="toast-stack" id="toastStack" aria-live="polite" aria-atomic="false"></div>

<aside class="admin-side">
    <a class="admin-brand" href="/admin">⚙️ Quản trị</a>

    <nav class="admin-nav" aria-label="Menu quản trị">
        <% adminMenu.forEach(function (g) { %>
            <p class="admin-nav-group"><%= g.group %></p>
            <% g.items.forEach(function (it) { %>
                <a href="<%= it.href %>" class="<%= section === it.key ? 'active' : '' %>"
                   <%= section === it.key ? 'aria-current="page"' : '' %>>
                    <span class="admin-nav-icon" aria-hidden="true"><%= it.icon %></span>
                    <span><%= it.label %></span>
                </a>
            <% }) %>
        <% }) %>
    </nav>

    <a class="admin-bar-link" href="/" target="_blank" rel="noopener">Xem site ↗</a>

    <% if (typeof adminUser !== 'undefined' && adminUser) { %>
        <div class="admin-account">
            <span class="admin-account-name" title="<%= adminUser.username %>">
                <span aria-hidden="true">👤</span>
                <%= adminUser.full_name || adminUser.username %>
                <span class="badge-role <%= adminUser.role %>"><%= adminUser.role === 'admin' ? 'Admin' : 'Staff' %></span>
            </span>
            <a class="admin-bar-link" href="/admin/logout">Đăng xuất</a>
        </div>
    <% } %>
</aside>

<style>
    .badge-role{display:inline-block;padding:1px 8px;border-radius:999px;font-size:12px;font-weight:600;line-height:1.7;vertical-align:middle}
    .badge-role.admin{background:#e7f0ff;color:#1b4fbf}
    .badge-role.staff{background:#eef1f4;color:#556}
    .admin-account{margin-top:16px;padding-top:12px;border-top:1px solid rgba(0,0,0,.08);display:flex;flex-direction:column;gap:6px}
    .admin-account-name{display:flex;align-items:center;gap:6px;flex-wrap:wrap;font-size:14px;font-weight:600}
    .admin-hint{font-weight:400;color:#888;font-size:12px}
</style>
