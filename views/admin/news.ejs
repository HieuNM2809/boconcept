<%- include('../partials/head') %>
<body class="admin">
<%- include('_nav', {section: 'news'}) %>
<main class="admin-wrap">
    <div class="admin-head">
        <h1>Tin tức</h1>
        <a class="btn btn-primary" href="/admin/news/new">+ Thêm bài viết</a>
    </div>

    <form class="admin-filter" method="get" action="/admin/news">
        <div class="admin-filter-grid">
            <div class="admin-filter-field">
                <label for="f_q">Tiêu đề</label>
                <input type="text" id="f_q" name="q" value="<%= filters.q %>" placeholder="Gõ tiêu đề VI hoặc EN">
            </div>
            <div class="admin-filter-field">
                <label for="f_feat">Nổi bật</label>
                <select id="f_feat" name="is_featured">
                    <option value="">Tất cả</option>
                    <option value="1" <%= filters.is_featured === '1' ? 'selected' : '' %>>Có</option>
                    <option value="0" <%= filters.is_featured === '0' ? 'selected' : '' %>>Không</option>
                </select>
            </div>
        </div>
        <div class="admin-filter-actions">
            <a class="btn-sm" href="/admin/news">Làm lại</a>
            <button class="btn-sm primary" type="submit">Lọc</button>
        </div>
    </form>

    <table class="admin-table">
        <thead>
        <tr><th>STT</th><th>Ảnh</th><th>Tiêu đề tin tức</th><th>Tiêu đề tiếng anh</th><th>Nội dung bài viết</th><th>Thứ tự</th><th title="Bài có sao vàng mới lên trang chủ">Nổi bật</th><th>Trạng thái</th><th></th></tr>
        </thead>
        <tbody>
        <% if (!items.length) { %><tr><td colspan="9" class="admin-empty">Chưa có bài viết nào.</td></tr><% } %>
        <% items.forEach(function (n) { %>
            <tr>
                <td><%= n.id %></td>
                <td><img class="admin-thumb" src="<%= n.image %>" alt="" loading="lazy"></td>
                <td><%= n.title_vi %></td>
                <td><%= n.title_en || '—' %></td>
                <td class="admin-cell-clip"><%= n.excerpt_vi || '—' %></td>
                <td><%= n.sort_order %></td>
                <td class="admin-star"><% if (n.is_featured) { %><span class="star on" title="Nổi bật — có trên trang chủ">★</span><% } else { %><span class="star off" title="Không nổi bật">★</span><% } %></td>
                <td><span class="badge-status <%= n.status ? 'on' : 'off' %>"><%= n.status ? 'Hiện' : 'Ẩn' %></span></td>
                <td class="admin-row-actions">
                    <a class="btn-sm" href="/admin/news/<%= n.id %>/edit">Sửa</a>
                    <form method="post" action="/admin/news/<%= n.id %>/delete" data-confirm="Xóa bài viết này?"><button class="btn-sm danger" type="submit">Xóa</button></form>
                </td>
            </tr>
        <% }) %>
        </tbody>
    </table>
</main>
<script src="/static/js/admin.js"></script>
</body>
</html>
