<%- include('../partials/head') %>
<body class="admin">
<%- include('_nav', {section: 'certificates'}) %>
<main class="admin-wrap">
    <div class="admin-head">
        <h1>CHỨNG NHẬN CÔNG TY</h1>
        <a class="btn btn-primary" href="/admin/certificates/new">+ Thêm chứng nhận</a>
    </div>

    <form class="admin-filter" method="get" action="/admin/certificates">
        <div class="admin-filter-grid">
            <div class="admin-filter-field">
                <label for="f_q">Tên chứng nhận</label>
                <input type="text" id="f_q" name="q" value="<%= filters.q %>" placeholder="Gõ tên VI hoặc EN">
            </div>
        </div>
        <div class="admin-filter-actions">
            <a class="btn-sm" href="/admin/certificates">Làm lại</a>
            <button class="btn-sm primary" type="submit">Lọc</button>
        </div>
    </form>
    <table class="admin-table" id="adminTable">
        <thead>
        <tr><th>STT</th><th>Ảnh chứng nhận</th><th>Tiêu đề chứng nhận</th><th>Tiêu đề tiếng anh</th><th>Thứ tự</th><th>Trạng thái</th><th></th></tr>
        </thead>
        <tbody>
        <% if (!items.length) { %><tr><td colspan="7" class="admin-empty">Chưa có chứng nhận.</td></tr><% } %>
        <% items.forEach(function (c) { %>
            <tr>
                <td><%= c.id %></td>
                <td><img class="admin-thumb" src="<%= c.image %>" alt="" loading="lazy"></td>
                <td><%= c.title_vi || '—' %></td>
                <td><%= c.title_en || '—' %></td>
                <td><%= c.sort_order %></td>
                <td><span class="badge-status <%= c.status ? 'on' : 'off' %>"><%= c.status ? 'Hiện' : 'Ẩn' %></span></td>
                <td class="admin-row-actions">
                    <a class="btn-sm" href="/admin/certificates/<%= c.id %>/edit">Sửa</a>
                    <form method="post" action="/admin/certificates/<%= c.id %>/delete" data-confirm="Xóa chứng nhận này?"><button class="btn-sm danger" type="submit">Xóa</button></form>
                </td>
            </tr>
        <% }) %>
        </tbody>
    </table>
</main>
<script src="/static/js/admin.js"></script>
</body>
</html>
