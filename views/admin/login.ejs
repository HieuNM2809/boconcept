<%- include('../partials/head') %>
<body class="admin admin-login">
<%# Trang đăng nhập ĐỘC LẬP: KHÔNG include _nav (chưa đăng nhập thì chưa có menu,
    và _nav cần adminUser vốn chưa tồn tại ở đây). CSS admin vẫn nạp qua body.admin.
    Giao diện "peaceful cream" — chữ tiếng Việt, ĐĂNG NHẬP VẪN BẰNG USERNAME
    (name="username"), không đụng backend/DB. %>
<main class="login-wrap">
    <form class="login-card" method="post" action="/admin/login" autocomplete="off" novalidate>
        <div class="login-badge">
            <img src="/static/images/logo.png" alt="HS Việt Nam">
        </div>
        <h1 class="login-title">Chào mừng trở lại</h1>
        <p class="login-sub">Đăng nhập để tiếp tục quản trị</p>

        <%# Lỗi từ server (sai tài khoản/mật khẩu) — khác với báo "bắt buộc" ở dưới. %>
        <% if (error) { %><p class="login-error" role="alert"><%= error %></p><% } %>

        <input type="hidden" name="next" value="<%= next %>">

        <div class="field">
            <input id="username" name="username" value="<%= username %>"
                   placeholder="Tên đăng nhập" aria-label="Tên đăng nhập"
                   autocomplete="username" autofocus required aria-describedby="err-username">
            <p class="field-msg" id="err-username" hidden>Vui lòng nhập tên đăng nhập</p>
        </div>

        <div class="field">
            <div class="field-pass">
                <input id="password" name="password" type="password"
                       placeholder="Mật khẩu" aria-label="Mật khẩu"
                       autocomplete="current-password" required aria-describedby="err-password">
                <button type="button" class="pass-toggle" data-target="password"
                        aria-label="Hiện mật khẩu" aria-pressed="false">
                    <svg class="eye" width="20" height="20" viewBox="0 0 24 24" fill="none"
                         stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M1 12s4-7 11-7 11 7 11 7-4 7-11 7-11-7-11-7Z"/><circle cx="12" cy="12" r="3"/>
                    </svg>
                    <svg class="eye-off" width="20" height="20" viewBox="0 0 24 24" fill="none"
                         stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"/>
                        <path d="M6.61 6.61A18.5 18.5 0 0 0 1 12s4 8 11 8a9.12 9.12 0 0 0 5.39-1.61"/><line x1="2" y1="2" x2="22" y2="22"/>
                    </svg>
                </button>
            </div>
            <p class="field-msg" id="err-password" hidden>Vui lòng nhập mật khẩu</p>
        </div>

        <button class="login-btn" type="submit">Đăng nhập</button>
    </form>
    <p class="login-foot"><a href="/">← Về trang chủ</a></p>
</main>

<style>
    /* body.admin là display:flex (sidebar + nội dung). Trang login KHÔNG có sidebar
       nên phải trả về block (2 class -> đè được body.admin 1 class). */
    body.admin.admin-login{
        display:block;min-height:100vh;margin:0;
        font-family:'Be Vietnam Pro',system-ui,-apple-system,Segoe UI,sans-serif;
        color:#6b5647;
        background:
            radial-gradient(1100px 560px at 50% -12%, #f7f4ee 0%, rgba(247,244,238,0) 62%),
            linear-gradient(162deg,#f1eee7 0%,#e8e4da 100%);
    }
    .login-wrap{min-height:100vh;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:16px;padding:28px}
    .login-card{
        width:100%;max-width:410px;box-sizing:border-box;
        background:#fff;border-radius:26px;padding:44px 40px 38px;text-align:center;
        box-shadow:0 1px 2px rgba(60,50,40,.05),0 30px 62px -24px rgba(122,96,64,.30);
        animation:cardIn .5s cubic-bezier(.2,.7,.2,1) both;
    }
    @keyframes cardIn{from{opacity:0;transform:translateY(14px)}to{opacity:1;transform:none}}

    /* Huy hiệu logo công ty — khung tròn trắng + quầng sáng tan cho hợp tông kem. */
    .login-badge{
        position:relative;width:92px;height:92px;margin:0 auto 22px;padding:12px;
        box-sizing:border-box;border-radius:50%;background:#fffdfb;
        display:flex;align-items:center;justify-content:center;
        box-shadow:0 0 0 1px rgba(212,172,124,.30),0 14px 28px -12px rgba(196,150,100,.60);
    }
    .login-badge::before{
        content:"";position:absolute;inset:-7px;border-radius:50%;z-index:-1;
        background:radial-gradient(circle at 50% 34%,rgba(223,184,138,.50),rgba(223,184,138,0) 70%);
    }
    .login-badge img{max-width:100%;max-height:100%;object-fit:contain;display:block}

    .login-title{margin:0 0 6px;font-size:30px;line-height:1.15;font-weight:700;color:#6f5b49;letter-spacing:.2px}
    .login-sub{margin:0 0 26px;font-size:15px;color:#a99c8c}

    .login-error{
        background:#fbeadf;color:#b4552f;border:1px solid #f0c3a6;
        padding:11px 14px;border-radius:12px;margin:0 0 18px;font-size:14px;text-align:left;
    }

    .field{margin:0 0 16px;text-align:left}
    .field input{
        width:100%;box-sizing:border-box;padding:15px 16px;font:inherit;font-size:15px;
        color:#6b5647;background:#fdf5f0;border:1.5px solid #ecccba;border-radius:14px;outline:none;
        transition:border-color .15s,box-shadow .15s,background .15s;
    }
    .field input::placeholder{color:#cf9075;opacity:1}
    .field input:focus{border-color:#d7a17f;background:#fff;box-shadow:0 0 0 4px rgba(214,161,127,.20)}
    .field.invalid input{border-color:#e79a7f;background:#fdf0ea}
    .field.invalid input:focus{box-shadow:0 0 0 4px rgba(231,154,127,.22)}

    /* Ô mật khẩu: chừa chỗ bên phải cho nút con mắt. */
    .field-pass{position:relative}
    .field-pass input{padding-right:48px}
    .pass-toggle{
        position:absolute;top:50%;right:8px;transform:translateY(-50%);
        display:flex;align-items:center;justify-content:center;width:34px;height:34px;
        padding:0;border:none;border-radius:9px;background:transparent;cursor:pointer;color:#c39a7e;
        transition:color .15s,background .15s;
    }
    .pass-toggle:hover{color:#a6754f;background:rgba(212,172,124,.14)}
    .pass-toggle .eye-off{display:none}
    .pass-toggle.on .eye{display:none}
    .pass-toggle.on .eye-off{display:block}

    .field-msg{margin:7px 4px 0;font-size:13px;color:#c76a4c}

    .login-btn{
        width:100%;margin-top:6px;padding:15px 16px;font:inherit;font-size:16px;font-weight:600;
        color:#5c4632;cursor:pointer;border:none;border-radius:14px;
        background:linear-gradient(135deg,#eccaa0 0%,#d9ad81 100%);
        box-shadow:0 14px 24px -12px rgba(206,160,110,.85);
        transition:filter .15s,transform .05s,box-shadow .15s;
    }
    .login-btn:hover{filter:brightness(1.03)}
    .login-btn:active{transform:translateY(1px)}
    .login-btn:focus-visible{outline:none;box-shadow:0 0 0 4px rgba(214,161,127,.35),0 14px 24px -12px rgba(206,160,110,.85)}

    .login-foot{margin:0;font-size:14px}
    .login-foot a{color:#ac9f8e;text-decoration:none;transition:color .15s}
    .login-foot a:hover{color:#6f5b49}

    @media (max-width:440px){.login-card{padding:36px 24px 30px;border-radius:22px}.login-title{font-size:26px}}
</style>

<script>
    (function () {
        // Con mắt hiện/ẩn mật khẩu
        document.querySelectorAll('.pass-toggle').forEach(function (btn) {
            btn.addEventListener('click', function () {
                var inp = document.getElementById(btn.dataset.target);
                if (!inp) return;
                var show = inp.type === 'password';
                inp.type = show ? 'text' : 'password';
                btn.classList.toggle('on', show);
                btn.setAttribute('aria-pressed', String(show));
                btn.setAttribute('aria-label', show ? 'Ẩn mật khẩu' : 'Hiện mật khẩu');
                inp.focus();
            });
        });

        // Kiểm tra "bắt buộc" phía client -> hiện thông báo dưới ô (giống mockup),
        // KHÔNG dùng bong bóng mặc định của trình duyệt (form có novalidate).
        var form = document.querySelector('.login-card');
        if (!form) return;
        var required = form.querySelectorAll('input[required]');
        form.addEventListener('submit', function (e) {
            var firstBad = null;
            required.forEach(function (inp) {
                var field = inp.closest('.field');
                var msg = field.querySelector('.field-msg');
                if (!inp.value.trim()) {
                    field.classList.add('invalid');
                    if (msg) msg.hidden = false;
                    if (!firstBad) firstBad = inp;
                }
            });
            if (firstBad) { e.preventDefault(); firstBad.focus(); }
        });
        required.forEach(function (inp) {
            inp.addEventListener('input', function () {
                var field = inp.closest('.field');
                var msg = field.querySelector('.field-msg');
                if (inp.value.trim()) { field.classList.remove('invalid'); if (msg) msg.hidden = true; }
            });
        });
    })();
</script>
</body>
</html>
