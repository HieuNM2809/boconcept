<%- include('partials/head') %>
<body>
<%- include('partials/header') %>

<% if (!page) { %>
    <section class="section">
        <div class="container center">
            <h2 class="section-title"><%= t.page.notFound %></h2>
            <a class="btn btn-outline" href="/"><%= t.page.backHome %></a>
        </div>
    </section>
<% } else { %>
    <div class="container">
        <nav class="breadcrumb">
            <a href="/"><%= t.page.home %></a>
            <span class="sep">/</span><span class="crumb-current"><%= pick(page, 'title') %></span>
        </nav>

        <%# `article-wide` bỏ mức 760px -> trang trải hết bề ngang .container, thẳng
            hàng với header/footer. `page-article` thêm phần bố cục ảnh góc bên dưới. %>
        <article class="article article-wide page-article">
            <h1 class="article-title"><%= pick(page, 'title') %></h1>

            <%# Ảnh THẢ NỔI ở góc trên-phải, chữ chảy vòng quanh. Muốn float ăn thì
                <figure> BẮT BUỘC đứng TRƯỚC đoạn chữ nó phải né, và cả hai phải chung
                một khối -> gói lead + body vào .page-article-flow (khối này tự clear
                ở cuối, nếu không phần ảnh dài hơn chữ sẽ thò xuống đè lên footer). %>
            <div class="page-article-flow">
                <% if (page.image) { %>
                    <figure class="article-hero page-article-figure">
                        <img src="<%= page.image %>" alt="<%= pick(page, 'title') %>">
                    </figure>
                <% } %>

                <% if (pick(page, 'excerpt')) { %>
                    <p class="article-lead"><%= pick(page, 'excerpt') %></p>
                <% } %>

                <%# bodyHtml do richtext.helper dựng ra: escape toàn bộ đầu vào rồi mới
                    sinh một tập thẻ cố định, nên in thô ở đây KHÔNG mở đường cho XSS. %>
                <div class="article-body">
                    <% if (bodyHtml) { %>
                        <%- bodyHtml %>
                    <% } else { %>
                        <p class="empty"><%= t.page.noBody %></p>
                    <% } %>
                </div>
            </div>
        </article>
    </div>
<% } %>

<%- include('partials/footer') %>
<script src="/static/js/main.js?v=<%= typeof assetVersion !== 'undefined' ? assetVersion : '1' %>"></script>
</body>
</html>
