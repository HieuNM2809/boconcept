<%- include('partials/head') %>
<body>
<%- include('partials/header') %>

<!-- ── HERO / Slideshow (spec 3.2 · animation) ─────────────────────────────── -->
<section class="hero">
    <div class="hero-track" id="heroTrack">
        <% heroSlides.forEach(function (s) { %>
            <%# KHÔNG còn role="img"/aria-label như trước: role="img" biến thẻ thành
                một nút lá với trình đọc màn hình, nuốt mất chữ bên trong — mà giờ
                tiêu đề/mô tả là chữ thật, phải đọc được. Ảnh nền không mang thông
                tin nào ngoài chữ đè lên nó nên để nguyên dạng trang trí. %>
            <div class="hero-slide" style="background-image:url('<%= s.image %>')">
                <%# Chữ nằm TRONG slide -> trượt cùng ảnh, mỗi slide một bộ chữ
                    riêng (sửa ở /admin/slides). Khác hẳn .hero-brand phía dưới:
                    dòng đó đứng ngoài track nên đứng yên và cố định trong code. %>
                <% if (pick(s, 'title') || pick(s, 'badge')) { %>
                    <div class="hero-copy">
                        <% if (pick(s, 'title')) { %>
                            <h2 class="hero-slide-title"><%= pick(s, 'title') %></h2>
                        <% } %>
                        <% if (pick(s, 'badge')) { %>
                            <p class="hero-slide-sub"><%= pick(s, 'badge') %></p>
                        <% } %>
                    </div>
                <% } %>
            </div>
        <% }) %>
    </div>

    <%# Slogan nằm NGOÀI .hero-track, không phải trong từng slide: chữ không đổi
        theo slide nên để trong track thì nó trượt ngang cùng ảnh và phải lặp lại
        n lần. Đặt ngoài -> ảnh chạy phía dưới, chữ đứng yên.
        Chữ sửa ở /admin/slogan; controller đã lo lùi về t.home.hero.brand khi
        chưa ai nhập. %>
    <div class="hero-brand"><%= heroBrand %></div>
    <button class="hero-arrow prev" data-dir="-1" aria-label="prev">&lsaquo;</button>
    <button class="hero-arrow next" data-dir="1" aria-label="next">&rsaquo;</button>
    <div class="hero-dots" id="heroDots">
        <% heroSlides.forEach(function (_, i) { %>
            <button class="dot <%= i === 0 ? 'active' : '' %>" data-idx="<%= i %>" aria-label="slide <%= i + 1 %>"></button>
        <% }) %>
    </div>
</section>

<!-- ── Khối Công năng (từ DB · /admin/features) ────────────────────────────── -->
<!-- Cả section nằm trong if: không dùng idiom <p class="empty"> như các mục khác,
     vì "đang tắt" phải là biến mất hẳn chứ không phải một ô xám "chưa có dữ liệu". -->
<% if (features.length) { %>
    <section class="features">
        <div class="container">
            <ul class="feature-strip">
                <% features.forEach(function (f) { %>
                    <%# tabindex="0" là bắt buộc: không có phần tử nhận focus thì
                        :focus-within không bao giờ kích hoạt -> bàn phím không đọc được mô tả %>
                    <li class="feature-item" tabindex="0" role="group">
                        <img class="feature-icon" src="<%= f.icon %>" alt="" loading="lazy">
                        <h3 class="feature-title"><%= pick(f, 'title') %></h3>
                        <% if (pick(f, 'description')) { %>
                            <p class="feature-desc"><%= pick(f, 'description') %></p>
                        <% } %>
                    </li>
                <% }) %>
            </ul>
        </div>
    </section>
<% } %>

<!-- ── Showcase sản phẩm nổi bật — tràn màn hình, 4 ảnh/khung ──────────────── -->
<!-- Nằm NGOÀI .container để tràn hết bề ngang. Lấy 8 sản phẩm, hiện 4, còn lại
     kéo bằng 2 nút ở giữa hai mép. -->
<% if (showcase.length) { %>
    <section class="showcase">
        <div class="showcase-track" id="showcaseTrack">
            <% showcase.forEach(function (p) { %>
                <a class="showcase-item" href="/products/<%= p.id %>">
                    <div class="showcase-media">
                        <img src="<%= p.thumbnail || ('https://picsum.photos/seed/p' + p.id + '/600/750') %>"
                             alt="<%= pick(p, 'name') %>" loading="lazy">
                    </div>
                    <div class="showcase-info">
                        <% if (p.category) { %><span class="showcase-cat"><%= pick(p.category, 'name') %></span><% } %>
                        <h3 class="showcase-name"><%= pick(p, 'name') %></h3>
                    </div>
                </a>
            <% }) %>
        </div>

        <%# data-scroll-by-item: cuộn đúng bề ngang 1 ảnh thay vì 260px cứng %>
        <button class="showcase-arrow prev" type="button"
                data-scroll="showcaseTrack" data-scroll-by-item data-dir="-1"
                aria-label="<%= t.common.actions.prev %>">&lsaquo;</button>
        <button class="showcase-arrow next" type="button"
                data-scroll="showcaseTrack" data-scroll-by-item data-dir="1"
                aria-label="<%= t.common.actions.next %>">&rsaquo;</button>
    </section>
<% } %>

<!-- ── Why / Categories: loop theo từng loại sản phẩm cha ─ -->
<%# Mỗi loại cha (parent_id = null) tạo một section split.
    Hover vào ảnh -> hiện danh sách loại con cấp 2 bên dưới. %>
<% categories.forEach(function(cat, i) { %>
<section class="section why<%= i === 0 ? '' : ' why--alt' %>" id="why-<%= cat.id %>">
    <div class="why-split">
        <div class="why-copy">
            <h2 class="why-title"><%= pick(cat, 'title') || pick(cat, 'name') %></h2>
            <% var catDesc = pick(cat, 'description'); %>
            <% if (catDesc) { %><p class="why-body"><%= catDesc %></p><% } %>
        </div>
        <a class="why-media" href="/categories/<%= cat.id %>">
            <img src="<%= cat.image || ('https://picsum.photos/seed/cat' + cat.id + '/900/700') %>"
                 alt="<%= pick(cat, 'name') %>" loading="<%= i === 0 ? 'eager' : 'lazy' %>">
            <span class="why-media-label"><%= pick(cat, 'name') %></span>
        </a>
    </div>
    <% if (cat.children && cat.children.length) { %>
        <div class="why-media-subs">
            <% cat.children.forEach(function(ch) { %>
                <a class="why-sub-item" href="/categories/<%= ch.id %>">
                    <div class="why-sub-thumb">
                        <img src="<%= ch.image || ('https://picsum.photos/seed/cat' + ch.id + '/300/400') %>"
                             alt="<%= pick(ch, 'name') %>" loading="lazy">
                    </div>
                    <span><%= pick(ch, 'name') %></span>
                </a>
            <% }) %>
        </div>
    <% } %>
</section>
<% }) %>

<!-- ── Categories (spec 3.2 · Loại sản phẩm nổi bật — TỪ DB) ────────────────── -->
<%# Chỉ hiện khi có danh mục cấp 1 nổi bật (is_featured, đánh dấu ở /admin/categories).
    Không mục nào nổi bật -> controller trả mảng rỗng -> cả section biến mất (như
    khối Công năng), không để lại ô "chưa có dữ liệu". %>
<% if (false && categories.length) { %>
    <%# Lưới loại sản phẩm cha (parent_id = null, is_featured) — mỗi tile hover
        xổ danh sách loại con cấp 2. %>
    <section class="section categories cat-showcase" id="categories">
        <div class="container">
            <div class="csc-grid">
                <% categories.forEach(function(cat) { %>
                    <div class="csc-item">
                        <a class="csc-thumb" href="/categories/<%= cat.id %>">
                            <img src="<%= cat.image || ('https://picsum.photos/seed/cat' + cat.id + '/450/600') %>"
                                 alt="<%= pick(cat, 'name') %>" loading="lazy">
                        </a>
                        <p class="csc-name"><%= pick(cat, 'name') %></p>
                        <% if (cat.children && cat.children.length) { %>
                            <div class="csc-dropdown">
                                <p class="csc-dropdown-title"><%= pick(cat, 'name') %></p>
                                <ul>
                                    <% cat.children.forEach(function(ch) { %>
                                        <li><a href="/categories/<%= ch.id %>"><%= pick(ch, 'name') %></a></li>
                                    <% }) %>
                                </ul>
                                <a class="csc-dropdown-all" href="/categories/<%= cat.id %>">Xem tất cả →</a>
                            </div>
                        <% } %>
                    </div>
                <% }) %>
            </div>
        </div>
    </section>
<% } %>

<!-- ── Partners (spec 3.2 · Đối tác hợp tác) ───────────────────────────────── -->
<%# ── Lưới ảnh "Style advice" — cả 8 ô lấy từ DB, sửa ở /admin/gallery.
    · Khe 1-3 (3 ô lớn): chứa NHIỀU ảnh, tự chuyển 5s/lần (main.js).
    · Khe 4-8 (5 ô nhỏ): đúng một ảnh, đứng yên.
    · Chữ tiêu đề vẫn đóng cứng (t.home.gallery), admin không sửa. %>
<section class="section gallery-grid-section" id="inspiration">
    <div class="container">
        <div class="gallery-head">
            <h2 class="gallery-title"><%= t.home.gallery.title %></h2>
            <p class="gallery-sub"><%= t.home.gallery.sub %></p>
        </div>
    </div>

    <%# Lớp vị trí lấy theo g.slot chứ KHÔNG theo chỉ số vòng lặp: thiếu một
        khe là cả mosaic xô lệch sang ô của khe khác.
        `is-big` chỉ đánh dấu vai trò bố cục (ô lớn, mobile chiếm full-width),
        không mang hiệu ứng — trùng đúng tập khe slider nên dùng chung cờ. %>
    <div class="collage" id="collage">
        <% gallery.forEach(function (g) { %>
            <figure class="collage-cell collage-slot-<%= g.slot %><%= g.isSlider ? ' is-big' : '' %>">
                <% g.images.forEach(function (im, i) { %>
                    <%# .is-active do SERVER đóng lên ảnh đầu, không phải JS —
                        nhờ vậy không có JS thì ô vẫn hiện ảnh chứ không trắng. %>
                    <img class="collage-img<%= i === 0 ? ' is-active' : '' %>"
                         src="<%= im.image %>" alt="<%= pick(im, 'alt') %>"
                         <%= i === 0 ? '' : 'aria-hidden="true"' %>
                         loading="<%= i === 0 ? 'eager' : 'lazy' %>">
                <% }) %>
            </figure>
        <% }) %>
    </div>
</section>

<%# ── Tin tức: header canh giữa + lưới bài viết 2 cột (ảnh → tiêu đề → mô tả → link) %>
<% if (news.length) { %>
    <section class="section news" id="news">
        <div class="container">
            <div class="news-head">
                <h2 class="news-title"><%= newsTitle %></h2>
                <p class="news-desc"><%= newsDesc %></p>
                <% if (newsCta) { %>
                    <a class="news-cta" href="<%= newsCtaLink %>"><%= newsCta %> <span aria-hidden="true">&rarr;</span></a>
                <% } %>
            </div>
        </div>

        <%# Lưới ảnh CỐ Ý nằm ngoài .container: phần chữ ở trên đọc tốt nhất khi
            bó trong 1200px, còn hai ô ảnh phải kéo gần sát mép màn hình. Hai bề
            rộng khác nhau -> phải là hai wrapper khác nhau, không thể dùng chung
            một .container rồi kéo âm lề (kéo âm sẽ tràn ngang, sinh scrollbar). %>
        <div class="container-wide">
            <div class="news-grid">
                <% news.forEach(function (n) { %>
                    <article class="news-card">
                        <%# Ảnh LUÔN mở bài viết, cố ý không dùng `n.link`: ảnh là
                            thumbnail của bài nên bấm vào phải ra đúng bài đó. Ô
                            "Link ngoài" trong admin chỉ chi phối nút CTA bên dưới. %>
                        <a class="news-card-media" href="/news/<%= n.id %>">
                            <img src="<%= n.image %>" alt="<%= pick(n, 'title') %>" loading="lazy">
                        </a>
                        <h3 class="news-card-title"><%= pick(n, 'title') %></h3>
                        <% if (pick(n, 'excerpt')) { %>
                            <p class="news-card-desc"><%= pick(n, 'excerpt') %></p>
                        <% } %>
                        <% if (pick(n, 'cta')) { %>
                            <a class="news-card-cta" href="<%= n.link || ('/news/' + n.id) %>">
                                <span aria-hidden="true">&rarr;</span> <%= pick(n, 'cta') %>
                            </a>
                        <% } %>
                    </article>
                <% }) %>
            </div>
        </div>
    </section>
<% } %>

<section class="section partners" id="partners">
    <div class="container">
        <p class="partners-sub"><%= t.home.partners.sub %></p>
        <h2 class="section-title center"><%= t.home.partners.title %></h2>
        <div class="partner-row">
            <% partners.forEach(function (p) { %>
                <% if (p.link) { %>
                    <a class="partner-logo" href="<%= p.link %>" target="_blank" rel="noopener"><% if (p.logo) { %><img src="<%= p.logo %>" alt="<%= p.name %>"><% } else { %><%= p.name %><% } %></a>
                <% } else { %>
                    <span class="partner-logo"><% if (p.logo) { %><img src="<%= p.logo %>" alt="<%= p.name %>"><% } else { %><%= p.name %><% } %></span>
                <% } %>
            <% }) %>
        </div>
    </div>
</section>

<!-- ── Certificates (spec 3.2 · Giấy chứng nhận công ty) ───────────────────── -->
<section class="section certs">
    <div class="container">
        <h2 class="section-title center"><%= t.home.certs.title %></h2>
        <div class="cert-row">
            <% certificates.forEach(function (c) { %>
                <%# Bỏ figcaption theo yêu cầu — chỉ còn ảnh. Tên chứng nhận vẫn
                    giữ ở `alt` để trình đọc màn hình và SEO còn đọc được. %>
                <figure class="cert-card">
                    <img src="<%= c.image %>" alt="<%= pick(c, 'title') %>" loading="lazy">
                </figure>
            <% }) %>
        </div>
    </div>
</section>

<%- include('partials/footer') %>
<script src="/static/js/main.js?v=<%= typeof assetVersion !== 'undefined' ? assetVersion : '1' %>"></script>
</body>
</html>
